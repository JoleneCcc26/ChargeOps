# Dependencies
node_modules/
server/node_modules/

# Build output
dist/
build/
.vite/
*.tsbuildinfo

# Environment / secrets — NEVER commit real credentials
.env
.env.*
!.env.example
server/.env
server/.env.*
!server/.env.example

# Vercel
.vercel/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/
*.log

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# ── Cloud project ───────────────────────────────────────────────────────────
# Local object storage. These are the "S3 bucket" contents — regenerate them,
# never commit them.
server/.storage/

# Demo files produced by `npm run seed:demo` (rebuilt from live station rows,
# so they are machine-specific).
samples/

# Local data-repair snapshots can contain database identifiers. Keep them for
# rollback/audit on this machine, but never commit them.
backups/

# Office lock files, created whenever a deliverable is open in Word or PowerPoint
~$*

# Course deliverables — report, slides, video script. Kept locally, not published.
deliverables/
