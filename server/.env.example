# Copy this file to server/.env, then change ONE line: DB_PASS.
# server/.env is gitignored — never commit real credentials.
#
# Everything else works as shipped. The demo passwords below are the ones the
# sign-in screen and the README both name, so a fresh clone runs without
# guesswork — they used to say `replace-me` while every document said
# `chargeops-demo`, which meant a teammate's first login always failed.
#
# They are demo credentials in plain text. Before this is deployed anywhere
# other people can reach, change every AUTH_*_PASSWORD and AUTH_TOKEN_SECRET.

# ── Relational store ────────────────────────────────────────────────────────
# Local MySQL for Milestone 1. In Milestone 2 these point at Amazon RDS and
# DB_SSL flips to true — no application code changes.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=yourpassword
DB_NAME=ev
# Set DB_SSL=true for managed cloud MySQL (RDS, Aiven, PlanetScale, etc.)
# Leave unset (or DB_SSL=false) for local MySQL.
DB_SSL=false

PORT=4000
# Leave false when Express is reached directly. Set true only behind one trusted
# reverse proxy (the Docker Nginx service does this in docker-compose.yml).
TRUST_PROXY=false

# ── Authentication and browser access ───────────────────────────────────────
# Local defaults exist so the demo starts immediately, but set new values
# before sharing a deployment. Production should replace this local provider
# with Cognito/OIDC and store secrets in AWS Secrets Manager.
AUTH_TOKEN_SECRET=local-demo-only-change-this-before-deploying
AUTH_TOKEN_TTL_SECONDS=28800
AUTH_OPS_USERNAME=ops
AUTH_OPS_PASSWORD=chargeops-demo
AUTH_TECH_USERNAME=tech
AUTH_TECH_PASSWORD=chargeops-demo
AUTH_VIEWER_USERNAME=viewer
AUTH_VIEWER_PASSWORD=chargeops-demo

# Finance approves membership, top-up and refund requests. Deliberately cannot
# raise one: whoever asks for money to move and whoever authorises it must be
# different people.
AUTH_FINANCE_USERNAME=finance
AUTH_FINANCE_PASSWORD=chargeops-demo

# A site host is a landlord within the network — the business whose car park the
# chargers sit in.
#
# Any company on record signs in as host<company id> (host1 … host6), resolved
# against the `company` table, so which company a host belongs to is not a
# setting at all. AUTH_HOST_COMPANY_ID only names the company that the plain
# `host` alias lands on.
#
# The company id is signed into the token, so a host cannot widen their own
# scope by editing a request — the claim would fail its HMAC check.
AUTH_HOST_USERNAME=host
AUTH_HOST_PASSWORD=chargeops-demo
AUTH_HOST_COMPANY_ID=6

# Comma-separated browser origins allowed to call the API directly.
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# ── Object storage ──────────────────────────────────────────────────────────
# Local disk today; becomes an S3 bucket name in Milestone 2.
STORAGE_BUCKET=chargeops-local
# Where objects live on disk. Defaults to server/.storage — override to put the
# bucket somewhere else (a different drive, a shared folder).
# STORAGE_DIR=E:/ChargeOps/server/.storage

# Secret used to sign download URLs (our local stand-in for an S3 presigned
# URL). Any random string works locally; in the cloud this disappears entirely
# because S3 signs with IAM credentials instead.
STORAGE_SIGNING_SECRET=change-me-to-any-random-string

# ── Scripts ─────────────────────────────────────────────────────────────────
# Where the load generator and the sample uploader point.
DEMO_API_URL=http://localhost:4000
DEMO_USERNAME=ops
DEMO_PASSWORD=chargeops-demo

# ── Daily platform simulator ─────────────────────────────────────────────────
# A MySQL Event enqueues one run at 00:10 server-local time for the previous
# calendar day. These bounds control how much realistic traffic each run adds.
SIMULATION_MIN_SESSIONS=12
SIMULATION_MAX_SESSIONS=24
SIMULATION_MIN_SITUATIONS=1
SIMULATION_MAX_SITUATIONS=3
